# ---------------------------------------------------------------------------
# Agentaus bridge configuration.  Copy to .env and fill in your key.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# REQUIRED: your Agentaus API key.
AGENTAUS_API_KEY=

# Agentaus endpoint (defaults shown).
AGENTAUS_BASE_URL=https://agentaus.com.au
AGENTAUS_PATH=/api/v1/chat/completions

# Replace the built-in Agentaus persona with Claude Code's agent system prompt.
# Leave this on: with it off, Agentaus prepends ~2,200 tokens of its own persona
# to every request and ignores much of Claude Code's tool guidance.
AGENTAUS_SYSTEM_PROMPT_OVERWRITE=true

# Where the bridge listens. Keep it on loopback unless you know you need more.
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8787

# Forward non-Agentaus models to the real Anthropic API so Claude models keep
# working in the same session. Set to false for an Agentaus-only bridge.
BRIDGE_PASSTHROUGH=true
ANTHROPIC_UPSTREAM_BASE_URL=https://api.anthropic.com

# Any model id containing one of these substrings routes to Agentaus.
AGENTAUS_MODEL_MARKERS=agentaus

# Route every request to Agentaus regardless of the model id.
AGENTAUS_FORCE_ALL=false

# Seconds between synthetic SSE pings while Agentaus is still thinking.
# Claude Code aborts a stream that is silent for 300s.
BRIDGE_PING_INTERVAL=10

# Re-chunk buffered replies into N-character deltas so output paints smoothly.
# Set to 0 to forward Agentaus' chunks as-is.
BRIDGE_CHUNK_CHARS=60

BRIDGE_LOG_LEVEL=info
# Log full request bodies (verbose; prompts contain your source code).
BRIDGE_LOG_BODIES=false

# Optional shared secret required from clients. Empty = no client auth.
BRIDGE_TOKEN=

# Agentaus context window. The bridge already defaults to 131072 in code, which is
# the real limit, so you do NOT need this line - it is here only as an escape hatch
# if Trellis Data changes the window. Set to 0 to disable the pre-flight check.
# AGENTAUS_MAX_INPUT_TOKENS=131072
