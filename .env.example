# ---------------------------------------------------------------------------
# Agentaus bridge configuration.  Copy to .env and fill in your key.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# REQUIRED: your Agentaus API key.
AGENTAUS_API_KEY=

# Agentaus endpoint (defaults shown).
AGENTAUS_BASE_URL=https://agentaus.com.au
AGENTAUS_PATH=/api/v1/chat/completions

# Replace the built-in Agentaus persona with Claude Code's agent system prompt.
# Leave this on: with it off, Agentaus prepends ~2,200 tokens of its own persona
# to every request and ignores much of Claude Code's tool guidance.
AGENTAUS_SYSTEM_PROMPT_OVERWRITE=true

# Where the bridge listens. Keep it on loopback unless you know you need more.
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8787

# Forward non-Agentaus models to the real Anthropic API so Claude models keep
# working in the same session. Set to false for an Agentaus-only bridge.
BRIDGE_PASSTHROUGH=true
ANTHROPIC_UPSTREAM_BASE_URL=https://api.anthropic.com

# Any model id containing one of these substrings routes to Agentaus.
AGENTAUS_MODEL_MARKERS=agentaus

# Route every request to Agentaus regardless of the model id.
AGENTAUS_FORCE_ALL=false

# Seconds between synthetic SSE pings while Agentaus is still thinking.
# Claude Code aborts a stream that is silent for 300s.
BRIDGE_PING_INTERVAL=10

# Re-chunk buffered replies into N-character deltas so output paints smoothly.
# Set to 0 to forward Agentaus' chunks as-is.
BRIDGE_CHUNK_CHARS=60

BRIDGE_LOG_LEVEL=info
# Log full request bodies (verbose; prompts contain your source code).
BRIDGE_LOG_BODIES=false
# How much of a body to log. The old fixed 4000 was shorter than the system prompt the
# bridge builds, so the tool list fell off the end of the line you were reading to see it.
# BRIDGE_LOG_BODY_CHARS=20000

# Optional shared secret required from clients. Empty = no client auth.
BRIDGE_TOKEN=

# Agentaus context window. You do NOT need this line: the bridge defaults to 131072
# in code, and corrects itself from the limit Agentaus reports in its own error
# messages. Setting it explicitly overrides both - useful only if you want a smaller
# window than Agentaus allows. Set to 0 to disable the check entirely.
# AGENTAUS_MAX_INPUT_TOKENS=131072

# When a conversation outgrows the window, ask Agentaus to summarise the older part
# and send that in place of it, rather than failing the turn. Set false to get a hard
# error instead - preferable on work where losing early context beats failing.
# AGENTAUS_AUTO_TRIM=true

# One cap on every Agentaus call the bridge makes on its own initiative: summarising,
# gap-checking, reviewing, planning, searching. Global rather than per-feature, because
# two features each capped at 6 permit 12. Your own turn is never gated behind it.
# AGENTAUS_MAX_CONCURRENCY=6

# Bridge-executed semantic search. Adds `agentaus_search` to the tools Agentaus sees
# and restricts Grep's description to literal lookups. The bridge runs this tool itself
# - Claude Code never sees the call, only the answer.
# AGENTAUS_SEARCH=true
# AGENTAUS_SEARCH_CHUNK_TOKENS=4000
# Agentaus' own web search, exposed as a tool. Claude Code's WebSearch is an Anthropic
# server-side stub with no input_schema, so it is dropped in translation - without this
# an Agentaus turn has no way to search the web at all. Slower than a normal reply,
# because a real search runs behind it.
# AGENTAUS_WEB_SEARCH=true
# AGENTAUS_SEARCH_MAX_CHUNKS=120
# AGENTAUS_SEARCH_MIN_CANDIDATES=3
# AGENTAUS_SEARCH_MAX_FILE_BYTES=1048576
# How many rounds of bridge-executed tool calls one turn may run before the answer has
# to stand. Stops a model that keeps searching from never replying.
# AGENTAUS_TOOL_ROUNDS=3
# Rounds spent telling the model a tool it named does not exist. Counted separately, so
# being corrected does not eat the budget meant for real work.
# AGENTAUS_CORRECTION_ROUNDS=3
# Ceiling on files one search reads. The shortlist is ranked, so this keeps the best.
# AGENTAUS_SEARCH_MAX_CANDIDATES=12
# Three independent searches over one question; a fact must appear in two to be reported
# as established. Slower than one search.
# AGENTAUS_INVESTIGATE=true
# Open a citation from a search result and read it in its section. A search hit proves a
# fact exists; it does not give enough to quote or paraphrase accurately. Without this
# the model cites evidence it cannot write from.
# AGENTAUS_ZOOM=true
# AGENTAUS_ZOOM_RADIUS_LINES=120
# AGENTAUS_ZOOM_MAX_LINES=400
# AGENTAUS_ZOOM_MAX_TOKENS=6000

# Condense oversized tool results before sending them. OFF by default: on work where the
# tool output IS the subject (a document being edited, a log being read), condensing it
# destroys what was asked about. Worth turning on for long sessions that otherwise
# compact repeatedly - measure the compaction rate before and after.
# AGENTAUS_DISTILL_RESULTS=false
# AGENTAUS_DISTILL_THRESHOLD_TOKENS=12000

# Append a derived list of tools already run to the system prompt, so the model stops
# re-running what it has already done. Pure function of the request; costs no calls.
# AGENTAUS_TOOL_LEDGER=true

# Directories agentaus_search may read, colon-separated. Empty allows any absolute path
# the model names, which is what Claude Code's own Read tool allows. Worth setting:
# these reads do NOT go through Claude Code's permission prompts.
# AGENTAUS_SEARCH_ROOTS=

# Agentaus has no native thinking mode, so the bridge asks it to plan the turn in a
# separate call and shows that plan as a thinking block. Runs when the turn carries
# tools, or when extended thinking is switched on in Claude Code.
# AGENTAUS_THINKING=true
# AGENTAUS_THINKING_VISIBLE=true
